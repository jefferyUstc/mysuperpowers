#!/usr/bin/env bash
# SessionStart hook for mysuperpowers plugin.
# Injects the 'using-mysuperpowers' meta-skill as additional context so the
# agent sees the skill index before any other work.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

using_content=$(cat "${PLUGIN_ROOT}/skills/using-mysuperpowers/SKILL.md")

escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

using_escaped=$(escape_for_json "$using_content")
session_context="<EXTREMELY_IMPORTANT>\nYou have mysuperpowers.\n\n**Below is the full content of the 'mysuperpowers:using-mysuperpowers' skill — your index of available skills. For every other skill, use the 'Skill' tool:**\n\n${using_escaped}\n</EXTREMELY_IMPORTANT>"

printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$session_context"

exit 0
